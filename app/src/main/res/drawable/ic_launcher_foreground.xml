                            <item android:offset="0" android:color="#FFF4EEDD" />
                            <item android:offset="1" android:color="#FFD6CBB0" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- spine, ribs and teeth -->
                <path
                    android:pathData="M50,50.8V61.6M47,52.7Q50,53.9 53,52.7M46.3,55.2Q50,56.5 53.7,55.2M45.6,57.7Q50,59.1 54.4,57.7M48,47.1V48.2M49.35,47.1V48.2M50.65,47.1V48.2M52,47.1V48.2"
                    android:strokeColor="#FF2A2118" android:strokeWidth="0.65" android:strokeLineCap="round" />
