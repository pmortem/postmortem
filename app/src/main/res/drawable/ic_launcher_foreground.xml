<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon foreground layer: a magnifying glass over a skeleton king in his coffin.
    Hand-converted from design/icon-full.svg; keep the two in step. Everything stays inside the 66dp
    safe zone. The SVG's 6% chess-board texture on the glass is left out (VectorDrawable has no patterns).
-->
