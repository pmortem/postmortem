            <!-- coffin lining (back rim) -->
            <path android:pathData="M34,58.4L66,58.4L67.6,61.6L32.4,61.6Z" android:fillColor="#FF7C2639" android:strokeColor="#FF1A140E" android:strokeWidth="0.6" android:strokeLineJoin="round" />

