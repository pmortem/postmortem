# The Stockfish release the app ships and the tests run: one source of truth.
# Official release assets: https://github.com/official-stockfish/Stockfish/releases/tag/sf_19
# The GPL source is in each tarball; the app's credits link to the tag.
STOCKFISH_TAG=sf_19
STOCKFISH_URL_BASE=https://github.com/official-stockfish/Stockfish/releases/download/sf_19
# android-arm64-universal runs on the phone (shipped as libstockfish.so),
# linux-x86-64-universal runs in the :core tests on the build box and in CI.
STOCKFISH_ANDROID_ASSET=stockfish-android-arm64-universal
STOCKFISH_ANDROID_SHA256=ebb24051aa4a222b4daaf049b882ecf1163d370c128fe02316602643f4d5e426
STOCKFISH_LINUX_ASSET=stockfish-linux-x86-64-universal
STOCKFISH_LINUX_SHA256=9defc0d4e55d49c65a6d042f3e571a39fcea499ade6dbe741b53b8c65e03611f
