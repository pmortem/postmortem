# The Stockfish release the app ships and the tests run: one source of truth.
# Official release assets: https://github.com/official-stockfish/Stockfish/releases/tag/sf_19
# The GPL source is in each tarball; the app's credits link to the tag.
STOCKFISH_TAG=sf_19
STOCKFISH_URL_BASE=https://github.com/official-stockfish/Stockfish/releases/download/sf_19
# linux-x86-64-universal runs in the :core tests on the build box and in CI.
# The phone's engine is built from the tag's source with the Android NDK (scripts/lab/build-stockfish), because the
# official Android binary has 4 KB-aligned segments and Google Play requires 16 KB. It ships as libstockfish.so.
STOCKFISH_SOURCE_URL=https://github.com/official-stockfish/Stockfish/archive/refs/tags/sf_19.tar.gz
STOCKFISH_SOURCE_SHA256=519b653d0d1ffb96531d982ccbe5c6a19425e8388e0e3c2f70f34b424ab32d76
STOCKFISH_ANDROID_ASSET=stockfish-android-arm64-16k
STOCKFISH_ANDROID_ARCH=armv8
STOCKFISH_ANDROID_NDK=30.0.16248370
STOCKFISH_ANDROID_LDFLAGS=-Wl,-z,max-page-size=16384
STOCKFISH_LINUX_ASSET=stockfish-linux-x86-64-universal
STOCKFISH_LINUX_SHA256=9defc0d4e55d49c65a6d042f3e571a39fcea499ade6dbe741b53b8c65e03611f
