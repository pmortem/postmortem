#!/usr/bin/env bash
# Builds core/src/main/resources/app/postmortem/core/opening/openings.tsv from Lichess's opening table
# (https://github.com/lichess-org/chess-openings, CC0): the five files a.tsv to e.tsv at one pinned commit, each checked
# against its sha256, joined without their header lines. Run it to refresh the table; commit the result.
set -euo pipefail

commit=712a58be746c143f4ab935b68acc50f4bac813eb
declare -A sha=(
  [a]=3282e4c9155289a29224f9a85fba0decb46efa35c2fa5e39662d2ac48fb0f793
  [b]=4bf2269a8e7571a00a7b346bae4fa86a241a6e7e86beab01783c81acb1622b63
  [c]=45e843c7b7e79a0d04d5bda879c9bd23f5a10974488bd8615e4f4c5d0749986f
  [d]=1cf4057a8aece94f27bb3f278ad410ee2844831a642364eeceaafa091dbcceda
  [e]=48c6f6645b031a5937c8386839debab0e2e48837251687ba1afb6369677f8546
)
out="$(cd "$(dirname "$0")/.." && pwd)/core/src/main/resources/app/postmortem/core/opening/openings.tsv"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

: > "$work/openings.tsv"
for volume in a b c d e; do
  curl -fsSL --retry 3 -o "$work/$volume.tsv" "https://raw.githubusercontent.com/lichess-org/chess-openings/$commit/$volume.tsv"
  echo "${sha[$volume]}  $work/$volume.tsv" | sha256sum -c --status || { echo "gen-openings: sha256 mismatch for $volume.tsv" >&2; exit 1; }
  tail -n +2 "$work/$volume.tsv" >> "$work/openings.tsv"
done
mkdir -p "$(dirname "$out")"
mv "$work/openings.tsv" "$out"
echo "gen-openings: $(wc -l < "$out") openings from $commit -> $out"
